# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
*.tgz

# Generated by `ray build` / `ray develop` from package.json (do not hand-edit)
raycast-env.d.ts

# Secrets: API keys live in Raycast preferences or the shell environment, never in the repo
.env
.env.*
!.env.example
*.pem

# Benchmark output (eval/bench.ts writes here); only the placeholder is tracked
eval/results/*
!eval/results/.gitkeep

# Test and coverage artifacts
coverage/
.vitest/
.vitest-cache/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local AI-tool state
.remember/
.claude/settings.local.json
.codex/
